// 与 schema.prisma 保持相同模型；修改数据结构时必须同步两份 schema 和两套迁移。
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model SongRequest {
  id            String     @id @default(cuid())
  queryCode     String     @unique
  source        String
  platformId    String
  title         String
  artist        String
  album         String?
  durationMs    Int
  coverUrl      String?
  grade         String?
  classNo       Int?
  requesterName String?
  status        String     @default("PENDING")
  rejectReason  String?
  flaggedWords  String     @default("[]")
  isManual      Boolean    @default(false)
  submitIp      String
  createdAt     DateTime   @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    AdminUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  schedule      Schedule?

  @@index([status, createdAt])
  @@index([grade, classNo, requesterName, createdAt])
  @@index([submitIp, createdAt])
}

model Schedule {
  id        String        @id @default(cuid())
  requestId String        @unique
  request   SongRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  playDate  String
  slotId    String
  slot      BroadcastSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  orderNo   Int
  createdAt DateTime      @default(now())

  @@unique([playDate, slotId, orderNo])
  @@index([playDate])
}

model BroadcastSlot {
  id        String     @id @default(cuid())
  name      String     @unique
  startTime String
  endTime   String
  maxCount  Int?
  maxMs     Int?
  sortOrder Int        @default(0)
  enabled   Boolean    @default(true)
  schedules Schedule[]
}

model CalendarDay {
  date String  @id
  kind String
  note String?
}

model AdminUser {
  id                 String        @id @default(cuid())
  username           String        @unique
  passwordHash       String
  role               String        @default("REVIEWER")
  mustChangePassword Boolean       @default(false)
  disabled           Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  reviewed           SongRequest[]
  auditLogs          AuditLog[]
}

model AuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  detail    String?
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model GradeConfig {
  grade      String @id
  classCount Int
}

model BannedWord {
  word      String   @id
  createdAt DateTime @default(now())
}

model SourceCredential {
  source        String    @id
  encryptedData String
  updatedAt     DateTime  @updatedAt
  lastCheckAt   DateTime?
  lastCheckOk   Boolean?
  note          String?
}

model SiteSetting {
  key   String @id
  value String
}
