// 数据模型的说明性文档在 API.md，改这里就要同步那份。
// 生成的 client 落在 server/src/generated/prisma，不进版本库。
//
// 用 SQLite：自托管服务器有持久磁盘，这套系统一天几十到几百条写入，单文件零运维，
// 备份就是拷一个文件。代价是 Prisma 的 SQLite 连接器不支持原生 enum、数组和 Json，于是：
//   - 原来的 5 个 enum 一律存字符串，取值由 src/lib/enums.ts 的联合类型与校验函数把关
//   - flaggedWords 存 JSON 数组字符串
//   - 日期存 "YYYY-MM-DD" 字符串，按 Asia/Shanghai 解读，天然避开时区偏移
//   - AuditLog.detail 存 JSON 字符串

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

/// 一条点歌。身份三项在超管关闭「要求填写身份」时为空。
model SongRequest {
  id            String     @id @default(cuid())
  queryCode     String     @unique
  source        String // netease | qq | kugou
  platformId    String
  title         String
  artist        String
  album         String?
  durationMs    Int
  coverUrl      String?
  grade         String? // G1 | G2 | G3
  classNo       Int?
  requesterName String?
  status        String     @default("PENDING") // PENDING | SCHEDULED | PLAYED | REJECTED
  rejectReason  String?
  flaggedWords  String     @default("[]") // JSON 数组字符串
  isManual      Boolean    @default(false)
  submitIp      String
  createdAt     DateTime   @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    AdminUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  schedule      Schedule?

  @@index([status, createdAt])
  @@index([grade, classNo, requesterName, createdAt])
  @@index([submitIp, createdAt])
}

/// 排期：日期 + 时段 + 顺序号，三者唯一。
model Schedule {
  id        String        @id @default(cuid())
  requestId String        @unique
  request   SongRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  playDate  String // YYYY-MM-DD
  slotId    String
  slot      BroadcastSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  orderNo   Int
  createdAt DateTime      @default(now())

  @@unique([playDate, slotId, orderNo])
  @@index([playDate])
}

/// 播出时段。startTime / endTime 为 "HH:mm"，按 Asia/Shanghai 解读。
model BroadcastSlot {
  id        String     @id @default(cuid())
  name      String     @unique
  startTime String
  endTime   String
  maxCount  Int?
  maxMs     Int?
  sortOrder Int        @default(0)
  enabled   Boolean    @default(true)
  schedules Schedule[]
}

/// 行政历。只有 SCHOOL 的日期可以排期。
model CalendarDay {
  date String  @id // YYYY-MM-DD
  kind String // SCHOOL | OFF | EXAM_NO_BROADCAST
  note String?
}

model AdminUser {
  id                 String        @id @default(cuid())
  username           String        @unique
  passwordHash       String
  role               String        @default("REVIEWER") // SUPER | REVIEWER
  mustChangePassword Boolean       @default(false)
  disabled           Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  reviewed           SongRequest[]
  auditLogs          AuditLog[]
}

model AuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  detail    String? // JSON 字符串
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

/// 每个年级的班级数量，超管可调。
model GradeConfig {
  grade      String @id // G1 | G2 | G3
  classCount Int
}

model BannedWord {
  word      String   @id
  createdAt DateTime @default(now())
}

/// 音源账号凭据。encryptedData 是 AES-256-GCM 密文，iv 与 authTag 一并编码在内。
model SourceCredential {
  source        String    @id // netease | qq | kugou
  encryptedData String
  updatedAt     DateTime  @updatedAt
  lastCheckAt   DateTime?
  lastCheckOk   Boolean?
  note          String?
}

/// 站点级开关。已用的 key：
/// requestsOpen(布尔) 点歌通道 · requireIdentity(布尔) 是否要求填写年级班级姓名
/// announcement(文本) 首页公告 · maxScheduleDays(整数) 最远可排天数
model SiteSetting {
  key   String @id
  value String
}
