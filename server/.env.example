# 复制成 server/.env 后填写。生产环境在 Render 的 Environment 里配同名变量。
# 完整说明见仓库根目录 DEPLOY.md。

# Neon Postgres 连接串
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 初始超管，仅 `npx prisma db seed` 时读取；留空则随机生成并打印一次
SEED_ADMIN_USER="yadmin"
SEED_ADMIN_PASSWORD=""

# 以下在后续阶段启用（S6 鉴权 / S7 音源凭据）
# JWT_SECRET=""
# CREDENTIAL_KEY=""

# 本地开发一般不用改
# PORT=3000
# HOST=0.0.0.0
# PUBLIC_BASE_URL="http://localhost:5173"
