# 复制成 server/.env 后按需修改。生产环境同名变量照填即可。
# 完整说明见仓库根目录 DEPLOY.md。

# SQLite 数据库文件。相对路径以 server/ 为基准，默认落在 server/data/app.db。
# 备份就是把这个文件（连同 -wal / -shm）拷走。
DATABASE_URL="file:./data/app.db"

# 初始超管，仅 `npm run seed --workspace server` 时读取；留空则随机生成并打印一次
SEED_ADMIN_USER="yadmin"
SEED_ADMIN_PASSWORD=""

# 以下在后续阶段启用（S6 鉴权 / S7 音源凭据）
# JWT_SECRET=""
# CREDENTIAL_KEY=""

# 本地开发一般不用改
# PORT=3000
# HOST=0.0.0.0
# PUBLIC_BASE_URL="http://localhost:5173"
