# 复制成 server/.env 后按需修改。生产环境同名变量照填即可。
# 完整说明见 docs/DEPLOY.md。

# sqlite（默认）或 postgresql。切换后先重新运行 Prisma Client 生成和迁移。
DATABASE_PROVIDER="sqlite"
# SQLite 相对路径以 server/ 为基准；PostgreSQL 使用 postgresql://user:password@host:5432/database。
DATABASE_URL="file:./data/app.db"

# 初始超管，仅 `npm run seed --workspace server` 时读取；留空则随机生成并打印一次
SEED_ADMIN_USER="yadmin"
SEED_ADMIN_PASSWORD=""

# 管理端 JWT 签名密钥，至少 32 字符，缺了直接启动失败。生成：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# 以下在后续阶段启用（S7 音源凭据）
# CREDENTIAL_KEY=""

# 酷狗上游服务（kugoumusicapi）。取址与将来的扫码登录走它，`npm run dev` 会一起起。
# 留空则只用直连实现；连不上会自动回落，不会让酷狗整源不可用。
KUGOU_API_URL="http://127.0.0.1:3300"
KUGOU_API_PORT="3300"

# 酷狗设备标识。不填每次启动临时生成，能用；但酷狗对频繁变化的设备指纹会加限制，
# 建议启动一次后把日志里那套抄下来固定住。GUID 是 uuid v4，DEV 是 10 位大写字符串。
# KUGOU_API_GUID=""
# KUGOU_API_DEV=""
# KUGOU_API_MAC="02:00:00:00:00:00"
# KUGOU_API_WEBGL=""

# 本地开发一般不用改
# PORT=3000
# HOST=0.0.0.0
# PUBLIC_BASE_URL="http://localhost:5173"
